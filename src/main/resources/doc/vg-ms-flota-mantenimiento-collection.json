									"if (jsonData.success && jsonData.data) {",
									"    pm.environment.set(\"order_id\", jsonData.data.id);",
									"    pm.environment.set(\"order_code\", jsonData.data.codigoOrden);",
									"    console.log(\"Order ID guardado: \" + jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
