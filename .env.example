# Environment variables template - vg-ms-fleet-maintenance
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to Git (already excluded in .gitignore).

# Server
SERVER_PORT=9012
SPRING_PROFILES_ACTIVE=dev

# MongoDB Atlas (Dedicated cluster per microservice - Database per Service)
SPRING_DATA_MONGODB_URI=mongodb+srv://<your_mongodb_user>:<your_mongodb_password>@<your_cluster.mongodb.net>/db_fleet?retryWrites=true&w=majority
MONGO_FLEET_DATABASE=db_fleet

# Security / Keycloak OIDC (HTTPS mandatory in prod, no localhost fallback)
KEYCLOAK_ENABLED=true
KEYCLOAK_TOKEN_MODE=KEYCLOAK
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/PRS
KEYCLOAK_JWK_SET_URI=http://localhost:8090/realms/PRS/protocol/openid-connect/certs

# Dependent microservices (HTTP inter-service communication)
SERVICES_RECURSOS_URL=http://localhost:9004
SERVICES_CATALOGO_URL=http://localhost:9005
SERVICES_INCIDENTES_URL=http://localhost:9003
